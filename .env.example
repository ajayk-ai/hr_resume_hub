# Copy to .env and fill in. Never commit .env or the service account key.

# ---- Google Sheets ----
GOOGLE_SERVICE_ACCOUNT_FILE=service.json
HR_SHEET_ID=<spreadsheet-id>
# Only if the service account uses domain-wide delegation; leave unset when the sheet
# is shared directly with the service account's email.
# GOOGLE_DELEGATED_USER=<user@company.com>
# Must match the scope authorized for delegation. Default: spreadsheets.readonly
# GOOGLE_SHEETS_SCOPE=https://www.googleapis.com/auth/spreadsheets

# ---- PostgreSQL ----
HR_DB_NAME=<database>
HR_DB_USER=<user>
HR_DB_PASSWORD=<password>
# HR_DB_HOST=localhost
# HR_DB_PORT=5432
# HR_DB_SCHEMA=resume_hub

# ---- Dashboard ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
DASHBOARD_SECRET_KEY=<random-string-of-32+-characters>
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8000
# Set to true when served over HTTPS (reverse proxy)
# DASHBOARD_HTTPS_ONLY=false
# DASHBOARD_SESSION_HOURS=8
